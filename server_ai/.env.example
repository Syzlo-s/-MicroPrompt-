# 轻提词 AI 中转服务 · 环境变量模板
# ---------------------------------------------------------------
# 服务端是 Python 标准库实现，**不会自动读取 .env**，需要显式加载：
#
#   cp .env.example .env && vi .env        # 填入真实值
#   set -a && . ./.env && set +a           # 加载到当前 shell
#   python3 ai_server.py
#
# 或者直接在命令行传（推荐用于 nohup / systemd）：
#   MP_DEEPSEEK_KEY='sk-xxxx' MP_ADMIN_KEY='xxxx' nohup python3 ai_server.py > ai_server.log 2>&1 &

# ---- 必填 ----
# DeepSeek Key：缺失时服务拒绝启动（源码内不再内置默认值）
MP_DEEPSEEK_KEY=
# 管理员密钥：留空则首次启动自动生成并写入 data/admin_key.txt
MP_ADMIN_KEY=

# ---- 可选（下面的值就是代码里的默认值）----
MP_PORT=2581
MP_DATA_DIR=
MP_CASDOOR_URL=http://127.0.0.1:2580
MP_FREE_DAILY=3
MP_MEMBER_DAILY_CAP=300
MP_RATE_LIMIT_SEC=2
# 本地联调：不调用 DeepSeek，直接返回假结果
MP_MOCK=
