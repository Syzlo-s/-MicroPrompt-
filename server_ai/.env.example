# 轻提词 AI 中转服务 · 环境变量模板
# ---------------------------------------------------------------
# 服务端是 Python 标准库实现，**不会自动读取 .env**，需要显式加载：
#
#   cp .env.example .env && vi .env        # 填入真实值
#   set -a && . ./.env && set +a           # 加载到当前 shell
#   python3 ai_server.py
#
# 或者直接在命令行传（推荐用于 nohup / systemd）：
#   MP_DEEPSEEK_KEY='sk-xxxx' MP_ADMIN_KEY='xxxx' nohup python3 ai_server.py > ai_server.log 2>&1 &

# ---- 必填 ----
# DeepSeek Key：缺失时服务拒绝启动（源码内不再内置默认值）
MP_DEEPSEEK_KEY=
# 管理员密钥：留空则首次启动自动生成并写入 data/admin_key.txt
MP_ADMIN_KEY=

# ---- 可选（下面的值就是代码里的默认值）----
MP_PORT=2581
MP_DATA_DIR=
MP_MOCK=
MP_FREE_DAILY=3
MP_MEMBER_DAILY_CAP=300
MP_RATE_LIMIT_SEC=2

# ---- 跨域（4.7.0 加固）----
# 留空（默认）= 管理接口 /ai/admin/* 不发 CORS 头，只有同源的 /admin 页面能调用；
# 客户端接口不受影响（桌面端 WebView2 的 origin 是 http://tauri.localhost）。
# 若要把后台挂到别的域下面访问，设为 * 恢复旧行为。
MP_CORS_ORIGINS=

# ---- 账号体系（4.1.0）----
# casdoor = 令牌仍交给 Casdoor 校验（默认，行为与 4.0.x 完全一致）
# builtin = 用本服务自建账号体系（登录/注册/校验都在本进程，额外监听 MP_AUTH_PORT）
MP_AUTH_MODE=casdoor
# builtin 模式下账号接口的端口；客户端把地址写死成 2580，所以线上保持默认即可（0 = 不监听）
MP_AUTH_PORT=2580
# 自签令牌有效期（秒，默认 7 天）；旧名 MP_JWT_TTL 仍兼容，两个都设时以本名为准
MP_JWT_TTL_SEC=604800
# 密码哈希迭代次数（默认 12 万；低配机器可降到 80000）
MP_PBKDF2_ITERS=120000
# 防爆破：同一用户名连续失败 5 次锁 10 分钟；同一 IP 15 分钟内失败 20 次开始限速
MP_LOGIN_MAX_FAIL=5
MP_LOGIN_LOCK_SEC=600
MP_IP_MAX_FAIL=20
MP_FAIL_WINDOW_SEC=900
# 仅 casdoor 模式使用
MP_CASDOOR_URL=http://127.0.0.1:2580

# ---- 其它 ----
# 客户端 .env 里的 client_id（前端可提取，不是机密）；secret 留空表示只校验"存在且非空"
MP_AUTH_CLIENT_ID=b49640f6c4dabd78ce94
MP_AUTH_CLIENT_SECRET=
# 重置密码时生成的临时密码字符集（留空用内置默认集，已去掉易混字符）
MP_PWD_ALPHABET=
# 在线升级更新包目录（默认 <脚本目录>/updates；换位置时填绝对路径）
MP_UPDATES_DIR=
