# 轻提词 V4.0 环境变量模板
# ---------------------------------------------------------------
# 用法：复制为 .env，填入真实值。
#   .env 已被 .gitignore 忽略，仅存在于本机，切勿提交或打包进分发物。
#
# 注意：Vite 在「构建时」把 VITE_* 变量内联进前端产物，因此这些值
# 对拿到安装包的人始终是可提取的（前端没有真正的秘密）。.env 的作用是
# 让公开仓库不含明文凭据，而不是让客户端变安全——详见 README 安全说明。

# ---- 服务端地址 ----
# Casdoor 认证服务（自托管）
VITE_CASDOOR_URL=http://127.0.0.1:2580
# AI 中转服务（server_ai/ai_server.py）
VITE_AI_URL=http://127.0.0.1:2581

# ---- Casdoor 应用凭据（Casdoor 后台 → 应用 app-microprompt）----
VITE_CASDOOR_CLIENT_ID=
VITE_CASDOOR_CLIENT_SECRET=

# ---- 离线内置管理员 ----
# 两项都留空则「内置管理员登录」入口整体关闭（推荐给公开仓库的默认状态）
VITE_LOCAL_ADMIN_USER=
VITE_LOCAL_ADMIN_PASSWORD=
